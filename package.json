{
  "name": "orostelco",
  "version": "0.0.1-alpha1",
  "private": true,
  "description": "Nextcloud GUI for OSS/BSS applications in telecommunications",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --mode development build",
    "watch": "vite --mode development build --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "stylelint": "stylelint \"src/**/*.vue\" \"src/**/*.scss\" \"src/**/*.css\"",
    "stylelint:fix": "stylelint \"src/**/*.vue\" \"src/**/*.scss\" \"src/**/*.css\" --fix",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.3.0"
  },
  "dependencies": {
    "@nextcloud/axios": "^2.6.0",
    "@nextcloud/dialogs": "^7.5.0",
    "@nextcloud/files": "^4.1.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/password-confirmation": "^6.1.0",
    "@nextcloud/router": "^3.2.0",
    "@nextcloud/vue": "^9.13.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/stylelint-config": "^3.2.2",
    "@nextcloud/vite-config": "^2.5.4",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "sass": "^1.105.1",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  }
}
